#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

// layer names
#define QWERTZ  0
#define NAV  1
#define SYMBOL  2
#define META    3
#define MOUSE   4
#define F_KEYS  5
#define NUMBER  6

// mouse settings
#define ZMK_POINTING_DEFAULT_MOVE_VAL 900  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15   // default: 10

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

// TODO: update tables in comments for visualizing layout
/ {
    prog_caps: programming_caps_word {
        compatible = "zmk,behavior-caps-word";
        #binding-cells = <0>;
        continue-list = <UNDERSCORE>;
    };
    macros {
        back_two: back_two {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp BACKSPACE 
                &macro_tap &kp BACKSPACE 
            >;
        };
    };

    behaviors {
      td_alt_backspace_F: tab_dance_alt_mouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <120>;
            bindings = <&mt LALT BACKSPACE>, <&lt F_KEYS &back_two>;
      };
      td_ctrl_meta: tab_dance_ctrl_meta {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LCTRL>, <&mo META>;
      };
      td_shift_caps_word: tab_dance_shift_caps_word {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHIFT>, <&prog_caps>;
      };
      back_for_tick: tab_dance_backward_forward_tick {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp PLUS &kp PLUS>, <&kp EQUAL &kp EQUAL>;
      };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTZ";
            // TODO: update ascii table
            //
            // -------------------------------------------------------------------------------------------------------------
            // |  TAB           |  Q         |  W         |  E        |  R  |  T                    |  Z          |  U   |  I       |  O      |  P            |  Ü  |
            // | CTRL/ESC       | SHFT/A     |CTRL/S      |  D        |  F  |  G                    |  H          |  J   |  K       |  CTRL/L |SHFT/Ö         |Ä/ctr|
            // | SHFT/caps word |   Y        |  X         |  C        |  V  |  B                    |  N          |  M   |  ,       |  .      |  -            | ESC |
            // | AltGr/Slash    |Super/Slash | SPC                                                  | SYMBOL/ENTER | ALT | AltGr/Backslash  |
            bindings = <
              &lt META TAB        &kp Q       &kp W       &kp E       &kp R         &kp T           &kp Y      &kp U      &kp I       &kp O       &kp P         &lt META LBKT
              &lt F_KEYS ESC      &mt LSHFT A &mt LCTRL S &mt LALT D &mt LMETA F    &kp G           &kp H      &mt LMETA J &mt LALT K &mt LCTRL L &mt LSHFT SEMI  &lt F_KEYS SQT
              &td_shift_caps_word &kp Z       &kp X       &kp C       &lt MOUSE V   &kp B           &kp N      &kp M      &kp COMMA   &kp DOT     &kp FSLH      &td_shift_caps_word
                                              &mt RALT LS(N7) &lt NUMBER TAB &lt SYMBOL SPACE       &lt NAV RET &mt LALT BACKSPACE &mt RALT RA(MINUS)
            >;
        };

        lower_layer {
            display-name = "NAV";
            // +------+---------+--------+-------+---------+------+    +-----+-----+-----+-----+-----+------+
            // |  TAB |  1      |  2     |  3    |  4      |  5   |    |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL |SHFT/POS1|CTRL/EDD|PAGE UP|PAGE DOWN| BSPC |    |LEFT |DOWN |  UP |RIGHT|SHIFT| CTRL |
            // | SHFT |prog_caps|        |       | DELETE | PRINT |    |     |SRCL↓|SRCL↑|     |     | SHIFT|
            //                           | RALT  | LMETA  | LALT  |    |     |     |     |
            bindings = <
                &kp TAB   &kp N1         &kp N2        &kp N3      &kp N4        &kp N5      &kp N6   &kp N7         &kp N8       &kp N9          &kp N0       &kp BSPC
                &kp LCTRL &mt LSHFT HOME &mt LCTRL END &kp PAGE_UP &kp PAGE_DOWN &kp BSPC    &kp LEFT &kp DOWN       &kp UP       &mt LCTRL RIGHT &kp LSHFT    &kp LCTRL
                &kp LSHFT &prog_caps     &none         &none       &kp DELETE    &kp PSCRN   &none    &msc SCRL_DOWN &msc SCRL_UP &kp LC(RBKT)    &kp LC(FSLH) &kp LSHFT
                                                       &kp RALT    &kp LMETA     &kp LALT    &none    &none    &none        
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // # see: 
            //    -- https://getreuer.info/posts/keyboards/symbol-layer/index.html
            //    -- (https://sunaku.github.io/moergo-glove80-keyboard.html#symbol-layer)
            //
            //  +---------------+---------------+-----------+-------------+-------------+---------+       +-------------+-----------+-----------+---------------+-------------+---------+
            //  |      €        |      €        |     ?     |      <      |     >       |    |    |       |      ^      |     {     |    }      |     $         |     `       |    §    |
            //  |      “        |      !        |     *     |     /       |     =       |    &    |       |      #      |     (     |    )      |     ;         |     "       |    “    |
            //  |      …        |      ~        |     +     |     [       |     ]       |    %    |       |      @      |     :     |    ,      |     .         |     '       |         |
            //                                              |             |             |         |       |    LSHIFT    |   LCTRL    |  RALT     |

            bindings = <
                &kp RA(E)       &kp RA(E)       &kp UNDER   &kp NUBS     $&kp LS(NUBS)  &kp RA(NUBS)      &kp GRAVE     &kp RA(N7)  &kp RA(N0)  &kp DLLR        &kp PLUS      &kp HASH
                &kp RA(V)       &kp EXCL        &kp RBRC    &kp AMPS      &kp RPAR      &kp CARET         &kp BSLH      &kp ASTRK   &kp LPAR    &kp LS(COMMA)   &kp AT        &kp RA(B)
                &kp RA(DOT)     &kp RA(RBKT)    &kp RBKT    &kp RA(N8)    &kp RA(N9)    &kp PRCNT         &kp RS(Q)     &kp LS(DOT) &trans      &trans          &kp LS(BSLH)  &none
                                                            &none         &none         &none             &kp LSHIFT    &kp LCTRL   &kp RALT
            >;
        };

        meta_layer {
            display-name = "META";
            bindings = <
                &none &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &bt BT_SEL 4    &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1    &bt BT_SEL 0 &none
                &none &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &bt BT_SEL 4    &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1    &bt BT_SEL 0 &none 
                &none &none        &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock    &studio_unlock  &bootloader  &sys_reset   &rgb_ug RGB_TOG &none        &none 
                                                   &kp C_PREV   &kp C_PLAY_PAUSE &kp C_NEXT    &kp C_MUTE      &kp C_VOL_DN &kp C_VOL_UP
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                &none         &none      &none      &none     &none          &none     &mkp MB4       &msc SCRL_DOWN &msc SCRL_UP &mkp MB5        &none  &none
                &td_ctrl_meta &kp LCTRL  &kp LSHIFT &none     &msc SCRL_DOWN &none     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &msc SCRL_DOWN &msc SCRL_UP
                &kp LSHIFT    &none      &none      &none     &msc SCRL_UP   &none     &mkp MCLK      &mkp LCLK      &mkp RCLK    &none           &none  &kp LSHIFT
                                                    &mkp MCLK &mkp LCLK &mkp RCLK      &kp LMETA      &kp LALT       &none       
            >;
        };

        extra_layer_3 {
            display-name = "F KEYS";
            bindings = <
                &kp F1 &kp F2        &kp F3       &kp F4 &kp F5    &kp F6  &kp F7 &kp F8 &kp F9 &kp F10       &kp F11        &kp F12
                &kp F1 &mt LSHIFT F2 &mt LCTRL F3 &kp F4 &kp F5    &kp F6  &kp F7 &kp F8 &kp F9 &mt LCTRL F10 &mt LSHIFT F11 &kp F12
                &none  &none         &none        &none  &none     &none   &none  &none  &none  &none         &none          &none
                                     &trans       &trans &trans    &trans  &trans &trans
            >;
        };

        //  +---------+---------+---------+-------------+-----------+-----+       +-------------+------+------+------+---------+-----+
        //  |         |         |   %     |     [       |  ]        |  %  |       |   /         |  7         |   8  |  9   |    (     |  )  | 
        //  |         |   #     |  ESC    |     _       |  $        |  *  |       |   *         |  4         |   5  |  6   |    +     |  ^  |
        //  |         |         |   =     |     (       |  )        |  ,  |       |   0         |  1         |   2  |  3   |    -     |  :  |
        //                                |             |           |     |       | LSHFT/ENTER |  LALT/DOT  |COMMA |
        extra_layer_4 {
            display-name = "NUMBER";
            bindings = <
                &none &none     &kp PRCNT &kp RA(N8)    &kp RA(N9)  &kp PRCNT         &kp LS(N7)    &kp N7       &kp N8 &kp N9 &kp LS(N8) &kp LS(N9) 
                &none &kp BSLH  &kp ESC   &kp LS(FSLH)  &kp DLLR    &kp LS(RBKT)      &kp LS(RBKT)  &kp N4       &kp N5 &kp N6 &kp RBKT  &kp GRAVE 
                &none &none     &kp RPAR  &kp RA(N7)    &kp LPAR    &kp COMMA         &kp N0        &kp N1       &kp N2 &kp N3 &kp FSLH   &kp LS(DOT)
                                          &none         &none       &none             &mt N0 &mt LALT DOT &kp COMMA
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &none &none &none &none &none &none  &none &none &none &none &none &none
                &none &none &none &none &none &none  &none &none &none &none &none &none
                &none &none &none &none &none &none  &none &none &none &none &none &none
                                     &none &none &none  &none &none &none       
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &none &none &none &none &none &none  &none &none &none &none &none &none
                &none &none &none &none &none &none  &none &none &none &none &none &none
                &none &none &none &none &none &none  &none &none &none &none &none &none
                                     &none &none &none  &none &none &none       
            >;
        };
    };
};
